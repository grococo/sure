<%= render DS::Dialog.new(width: "sm") do |dialog| %>
  <% dialog.with_header(title: t(".title"), subtitle: t(".subtitle", account: @account.name)) %>

  <% dialog.with_body do %>
    <% if @allocation.lines.empty? %>
      <p class="text-sm text-secondary"><%= t(".no_holdings") %></p>
    <% else %>
      <%= styled_form_with url: account_allocation_targets_path(@account), method: :patch, scope: :targets, class: "space-y-3", data: { turbo_frame: "_top" } do |f| %>
        <% if @error.present? %>
          <%= render DS::Alert.new(message: @error, variant: :error) %>
        <% end %>

        <% @allocation.lines.each do |line| %>
          <%= f.number_field line.security.id,
                label: line.name,
                value: (params.dig(:targets, line.security.id) || line.target_percent&.to_s("F")),
                min: 0, max: 100, step: "any", inputmode: "decimal",
                placeholder: t(".placeholder", percent: number_to_percentage(line.actual_percent, precision: 1)) %>
        <% end %>

        <p class="text-xs text-secondary"><%= t(".hint") %></p>

        <div class="flex justify-end gap-2 pt-1">
          <%= render DS::Button.new(text: t(".cancel"), variant: "secondary", type: "button", data: { action: "DS--dialog#close" }) %>
          <%= render DS::Button.new(text: t(".submit"), type: "submit") %>
        </div>
      <% end %>
    <% end %>
  <% end %>
<% end %>
